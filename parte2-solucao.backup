<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Parte 2: A Busca pela Solução</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'SF Pro Display', sans-serif;
            background: #000000;
            color: #FFFFFF;
            overflow: hidden;
            -webkit-font-smoothing: antialiased;
        }

        .slide {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1);
            51.2px;
        }

        .slide.active {
            opacity: 1;
            visibility: visible;
            z-index: 1;
        }

        .slide-content {
            max-width: 1400px;
            width: 100%;
            text-align: center;
        }

        /* Navigation */
        .slide-indicator {
            position: fixed;
            bottom: 40px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            9.6px;
            z-index: 100;
        }

        .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.3);
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .dot.active {
            background: #007AFF;
            width: 24px;
            border-radius: 4px;
        }

        .nav-hint {
            position: fixed;
            bottom: 80px;
            left: 50%;
            transform: translateX(-50%);
            color: #98989D;
            0.6rem;
            z-index: 100;
        }

        /* Typography */
        h1 {
            4.5rem;
            font-weight: 800;
            line-height: 1.1;
            letter-spacing: -3px;
            margin-bottom: 24px;
        }

        h2 {
            3.2rem;
            font-weight: 700;
            line-height: 1.1;
            letter-spacing: -2px;
            margin-bottom: 32px;
        }

        h3 {
            2.2rem;
            font-weight: 600;
            line-height: 1.2;
            letter-spacing: -1px;
            margin-bottom: 24px;
        }

        p {
            1.2rem;
            line-height: 1.6;
            color: #98989D;
            max-width: 900px;
            margin: 0 auto 30px;
        }

        .subtitle {
            1.6rem;
            color: #98989D;
            font-weight: 400;
        }

        .highlight {
            color: #007AFF;
            font-weight: 600;
        }

        .warning {
            color: #FF9500;
            font-weight: 600;
        }

        .danger {
            color: #FF3B30;
            font-weight: 600;
        }

        .success {
            color: #34C759;
            font-weight: 600;
        }

        /* Icon */
        .icon {
            6.4rem;
            margin-bottom: 32px;
            display: inline-block;
            animation: float 3s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-20px); }
        }

        /* Gradient Text */
        .gradient-text {
            background: linear-gradient(135deg, #007AFF, #5856D6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        /* Quote */
        .quote {
            1.9rem;
            font-weight: 600;
            line-height: 1.4;
            color: #FFFFFF;
            max-width: 1000px;
            48.0px auto;
            38.4px;
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(20px);
            border-radius: 24px;
            border-left: 6px solid #007AFF;
            text-align: left;
            position: relative;
        }

        .quote::before {
            content: '"';
            5.1rem;
            position: absolute;
            top: 20px;
            left: 30px;
            color: #007AFF;
            opacity: 0.3;
        }

        .quote-author {
            1.0rem;
            color: #98989D;
            margin-top: 30px;
            font-weight: 400;
        }

        /* Grid */
        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            48.0px;
            margin-top: 60px;
        }

        .grid-3 {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            32.0px;
            margin-top: 60px;
        }

        .card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(20px);
            border-radius: 24px;
            32.0px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            text-align: center;
        }

        .card.success {
            border-color: #34C759;
        }

        .card.warning {
            border-color: #FF9500;
        }

        .card.danger {
            border-color: #FF3B30;
        }

        .card-icon {
            2.6rem;
            margin-bottom: 20px;
            display: block;
        }

        .card h4 {
            1.3rem;
            font-weight: 600;
            margin-bottom: 12px;
        }

        .card p {
            0.8rem;
            line-height: 1.6;
            color: #98989D;
        }

        /* Big Icon with Text */
        .big-icon-text {
            64.0px 0;
        }

        .big-icon-text .icon {
            7.7rem;
            margin-bottom: 24px;
        }

        .big-icon-text h3 {
            2.6rem;
            margin-bottom: 16px;
        }

        /* Timeline Vertical */
        .timeline-v {
            max-width: 800px;
            48.0px auto;
            position: relative;
            padding-left: 100px;
        }

        .timeline-v::before {
            content: '';
            position: absolute;
            left: 40px;
            top: 0;
            bottom: 0;
            width: 3px;
            background: linear-gradient(to bottom, #007AFF, #5856D6);
        }

        .timeline-step {
            margin-bottom: 64px;
            position: relative;
        }

        .timeline-step-icon {
            position: absolute;
            left: -60px;
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #007AFF, #5856D6);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            1.6rem;
            box-shadow: 0 10px 40px rgba(0, 122, 255, 0.4);
        }

        .timeline-step-content {
            text-align: left;
        }

        .timeline-step h4 {
            1.6rem;
            font-weight: 700;
            margin-bottom: 12px;
            color: #007AFF;
        }

        .timeline-step p {
            1.0rem;
            line-height: 1.7;
            color: #98989D;
            margin: 0;
        }

        /* Comparison */
        .comparison {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            48.0px;
            align-items: center;
            margin-top: 60px;
        }

        .comparison-side {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(20px);
            border-radius: 24px;
            38.4px;
            text-align: center;
        }

        .comparison-side.before {
            border: 2px solid #FF3B30;
        }

        .comparison-side.after {
            border: 2px solid #34C759;
        }

        .comparison-label {
            0.6rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: 700;
            margin-bottom: 24px;
            opacity: 0.6;
        }

        .comparison-icon {
            3.2rem;
            margin-bottom: 24px;
        }

        .comparison-text {
            1.0rem;
            line-height: 1.6;
        }

        .comparison-arrow {
            2.6rem;
            color: #007AFF;
        }

        /* CTA Button */
        .cta-button {
            display: inline-block;
            background: linear-gradient(135deg, #007AFF, #5856D6);
            color: white;
            12.8px 50px;
            border-radius: 50px;
            1.0rem;
            font-weight: 600;
            text-decoration: none;
            margin-top: 60px;
            transition: all 0.3s ease;
            box-shadow: 0 10px 30px rgba(0, 122, 255, 0.3);
        }

        .cta-button:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(0, 122, 255, 0.4);
        }

        /* Responsive */
        @media (max-width: 1200px) {
            .slide { 38.4px 40px; }
            h1 { 3.2rem; }
            h2 { 2.6rem; }
            h3 { 1.9rem; }
            .timeline-v { padding-left: 80px; }
        }

        @media (max-width: 768px) {
            .slide { 25.6px 20px; }
            h1 { 2.2rem; }
            h2 { 1.8rem; }
            h3 { 1.4rem; }
            p { 0.8rem; }
            .subtitle { 1.2rem; }
            .icon { 3.8rem; margin-bottom: 24px; }
            .quote { 1.0rem; 19.2px; }
            .quote::before { 3.2rem; top: 10px; left: 15px; }
            .quote-author { 0.8rem; }
            .grid-2, .grid-3 { grid-template-columns: 1fr; 24.0px; }
            .card { 22.4px; }
            .card-icon { 1.9rem; }
            .card h4 { 1.0rem; }
            .card p { 0.7rem; }
            .big-icon-text .icon { 5.1rem; }
            .big-icon-text h3 { 1.6rem; }
            .timeline-v { padding-left: 60px; }
            .timeline-step { margin-bottom: 48px; }
            .timeline-step-icon { left: -50px; width: 60px; height: 60px; 1.3rem; }
            .timeline-step h4 { 1.3rem; }
            .timeline-step p { 0.8rem; }
            .comparison { grid-template-columns: 1fr; 24.0px; }
            .comparison-arrow { transform: rotate(90deg); }
            .comparison-side { 25.6px; }
            .nav-hint { 0.5rem; bottom: 70px; }
        }

        @media (max-width: 480px) {
            .slide { 19.2px 15px; }
            h1 { 1.6rem; letter-spacing: -1px; }
            h2 { 1.3rem; letter-spacing: -1px; }
            h3 { 1.2rem; }
            p { 0.7rem; }
            .subtitle { 0.9rem; }
            .icon { 3.2rem; }
            .quote { 0.8rem; 16.0px; }
            .card { 16.0px; }
            .card-icon { 1.6rem; }
            .card h4 { 0.9rem; }
            .card p { 0.6rem; }
            .big-icon-text .icon { 3.8rem; }
            .big-icon-text h3 { 1.3rem; }
            .timeline-v { padding-left: 50px; }
            .timeline-step-icon { left: -45px; width: 50px; height: 50px; 1.0rem; }
            .timeline-step h4 { 1.0rem; }
            .timeline-step p { 0.6rem; }
            .comparison-side { 19.2px; }
            .comparison-icon { 2.2rem; }
            .comparison-text { 0.8rem; }
            .dot { width: 6px; height: 6px; }
            .dot.active { width: 18px; }
            .cta-button { 11.2px 40px; 0.8rem; }
        }

        /* Animations */
        .slide.active .slide-content > * {
            animation: slideInUp 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
        }

        @keyframes slideInUp {
            from {
                opacity: 0;
                transform: translateY(50px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>
<body>
    <!-- Slide 1: Título -->
    <div class="slide active" data-slide="0">
        <div class="slide-content">
            <div class="icon">🔍</div>
            <h1 class="gradient-text">Parte 2</h1>
            <p class="subtitle">A Busca pela Solução</p>
        </div>
    </div>

    <!-- Slide 2: Luciano Assume -->
    <div class="slide" data-slide="1">
        <div class="slide-content">
            <h2>Luciano Assume</h2>
            <p>Com a saída de André, <span class="highlight">Luciano</span> assume a continuidade da transformação</p>
            <div class="icon" style="margin-top: 60px;">👨‍💼</div>
            <p style="1.4rem; color: #FFFFFF;">O legado estava construído. Mas como evoluir ainda mais?</p>
        </div>
    </div>

    <!-- Slide 3: A Ideia do Laboratório -->
    <div class="slide" data-slide="2">
        <div class="slide-content">
            <h2>A Ideia do Laboratório</h2>
            <p>Luciano desenvolve uma <span class="highlight">estratégia experimental</span> para fazer as coisas evoluírem</p>
            <div class="big-icon-text">
                <div class="icon">🧪</div>
                <h3>Laboratório de Inovação</h3>
                <p style="1.3rem; color: #FFFFFF;">Um ambiente controlado para testar novas soluções</p>
            </div>
        </div>
    </div>

    <!-- Slide 4: O Laboratório em Ação -->
    <div class="slide" data-slide="3">
        <div class="slide-content">
            <h2>O Laboratório em Ação</h2>
            <p>Desenvolvimento de ferramentas e processos inovadores</p>
            <div class="grid-3">
                <div class="card">
                    <span class="card-icon">🔬</span>
                    <h4>Experimentação</h4>
                    <p>Testes de novas abordagens e tecnologias</p>
                </div>
                <div class="card">
                    <span class="card-icon">📊</span>
                    <h4>Métricas</h4>
                    <p>Acompanhamento rigoroso de resultados</p>
                </div>
                <div class="card">
                    <span class="card-icon">🔄</span>
                    <h4>Iteração</h4>
                    <p>Ajustes contínuos baseados em dados</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Slide 5: Resultados Satisfatórios -->
    <div class="slide" data-slide="4">
        <div class="slide-content">
            <h2>Resultados Satisfatórios</h2>
            <p>Tecnicamente, o laboratório <span class="success">funcionou</span></p>
            <div class="grid-2">
                <div class="card success">
                    <span class="card-icon">✅</span>
                    <h4>Soluções Viáveis</h4>
                    <p>Ferramentas desenvolvidas mostraram potencial</p>
                </div>
                <div class="card success">
                    <span class="card-icon">📈</span>
                    <h4>Melhorias Comprovadas</h4>
                    <p>Processos evoluíram em qualidade</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Slide 6: Mas... -->
    <div class="slide" data-slide="5">
        <div class="slide-content">
            <h2>Mas...</h2>
            <p>Dois problemas críticos surgiram</p>
            <div class="icon" style="margin-top: 60px;">⚠️</div>
        </div>
    </div>

    <!-- Slide 7: Problema 1 - Custo Elevado -->
    <div class="slide" data-slide="6">
        <div class="slide-content">
            <h2>Problema 1: Custo Elevado</h2>
            <p>O investimento necessário era <span class="danger">muito alto</span></p>
            <div class="card danger" style="max-width: 700px; 48.0px auto;">
                <span class="card-icon">💰</span>
                <h4>Inviabilidade Financeira</h4>
                <p style="1.0rem;">Manter o laboratório e escalar as soluções demandava recursos além do orçamento disponível</p>
            </div>
        </div>
    </div>

    <!-- Slide 8: Problema 2 - Baixo Engajamento -->
    <div class="slide" data-slide="7">
        <div class="slide-content">
            <h2>Problema 2: Baixo Engajamento</h2>
            <p>As empresas parceiras <span class="danger">não engajaram</span> como esperado</p>
            <div class="card danger" style="max-width: 700px; 48.0px auto;">
                <span class="card-icon">😔</span>
                <h4>Falta de Adesão</h4>
                <p style="1.0rem;">Resistência das empresas de cobrança em adotar as novas soluções e processos</p>
            </div>
        </div>
    </div>

    <!-- Slide 9: A Decisão Difícil -->
    <div class="slide" data-slide="8">
        <div class="slide-content">
            <h2>A Decisão Difícil</h2>
            <div class="quote">
                Não podemos continuar investindo recursos em algo que não está gerando o retorno esperado. Precisamos pausar.
                <div class="quote-author">— Luciano</div>
            </div>
        </div>
    </div>

    <!-- Slide 10: Suspensão do Projeto -->
    <div class="slide" data-slide="9">
        <div class="slide-content">
            <h2>Suspensão do Projeto</h2>
            <p>O laboratório é <span class="warning">pausado</span></p>
            <div class="big-icon-text">
                <div class="icon">⏸️</div>
                <p style="1.3rem; color: #FFFFFF;">Uma pausa estratégica para repensar a abordagem</p>
            </div>
        </div>
    </div>

    <!-- Slide 11: Alguns Meses Depois -->
    <div class="slide" data-slide="10">
        <div class="slide-content">
            <h2>Alguns Meses Depois...</h2>
            <p>Luciano muda de estratégia</p>
            <div class="icon" style="margin-top: 60px;">⏳</div>
            <p style="1.4rem; color: #FFFFFF;">Em vez de desenvolver internamente, foca em <span class="highlight">capacitar as empresas</span></p>
        </div>
    </div>

    <!-- Slide 12: Pedido de Maturidade -->
    <div class="slide" data-slide="11">
        <div class="slide-content">
            <h2>Pedido de Maturidade Operacional</h2>
            <p style="margin-bottom: 48px;">Luciano solicita que as empresas parceiras <span class="highlight">evoluam suas operações</span></p>
            <div class="grid-3">
                <div class="card">
                    <div class="card-icon">📋</div>
                    <h4>Diagnóstico</h4>
                    <p>Avaliação do nível de maturidade atual</p>
                </div>
                <div class="card">
                    <div class="card-icon">🎯</div>
                    <h4>Metas Claras</h4>
                    <p>Definição de objetivos de evolução</p>
                </div>
                <div class="card">
                    <div class="card-icon">🤝</div>
                    <h4>Parceria</h4>
                    <p>Compromisso mútuo de crescimento</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Slide 13: O Tempo Passa -->
    <div class="slide" data-slide="12">
        <div class="slide-content">
            <h2>O Tempo Passa</h2>
            <p>Enquanto as empresas trabalham em sua evolução...</p>
            <div class="icon" style="margin-top: 60px;">⌛</div>
            <p style="1.4rem; color: #FFFFFF;">Algo inesperado estava sendo desenvolvido</p>
        </div>
    </div>

    <!-- Slide 14: Cobcred Apresenta -->
    <div class="slide" data-slide="13">
        <div class="slide-content">
            <h2>Cobcred Apresenta</h2>
            <p>Uma das empresas parceiras traz uma <span class="highlight">solução completa</span></p>
            <div class="big-icon-text">
                <div class="icon">🎁</div>
                <h3>O Cobhub</h3>
                <p style="1.3rem; color: #FFFFFF;">Um ecossistema integrado para cobrança inteligente</p>
            </div>
        </div>
    </div>

    <!-- Slide 15: A Revelação -->
    <div class="slide" data-slide="14">
        <div class="slide-content">
            <h2>A Revelação</h2>
            <p>A <span class="highlight">Cobcred</span> desenvolveu exatamente o que faltava</p>
            <div class="grid-2">
                <div class="card">
                    <span class="card-icon">🎯</span>
                    <h4>Visão Integrada</h4>
                    <p>Todas as ferramentas em um único ambiente</p>
                </div>
                <div class="card">
                    <span class="card-icon">💰</span>
                    <h4>Custo Viável</h4>
                    <p>Solução escalável sem investimento proibitivo</p>
                </div>
                <div class="card">
                    <span class="card-icon">🤖</span>
                    <h4>Inteligência Artificial</h4>
                    <p>IA aplicada em toda a jornada</p>
                </div>
                <div class="card">
                    <span class="card-icon">🎮</span>
                    <h4>Gamificação</h4>
                    <p>Engajamento através de mecânicas de jogo</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Slide 16: Luciano Conhece o Cobhub -->
    <div class="slide" data-slide="15">
        <div class="slide-content">
            <h2>Luciano Conhece o Cobhub</h2>
            <div class="quote">
                Isso é exatamente o que precisávamos. A visão que André tinha, mas que não conseguimos concretizar internamente, está aqui.
                <div class="quote-author">— Luciano</div>
            </div>
        </div>
    </div>

    <!-- Slide 17: O Novo Momento -->
    <div class="slide" data-slide="16">
        <div class="slide-content">
            <h2>O Novo Momento</h2>
            <p>A parceria entre Banco Pan e Cobcred <span class="success">começa</span></p>
            <div class="comparison">
                <div class="comparison-side before">
                    <div class="comparison-label">Antes</div>
                    <div class="comparison-icon">🧩</div>
                    <div class="comparison-text">Soluções fragmentadas e caras</div>
                </div>
                <div class="comparison-arrow">→</div>
                <div class="comparison-side after">
                    <div class="comparison-label">Agora</div>
                    <div class="comparison-icon">🎯</div>
                    <div class="comparison-text">Ecossistema integrado e viável</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Slide 18: O Cobdesk Nasce -->
    <div class="slide" data-slide="17">
        <div class="slide-content">
            <div class="icon">✨</div>
            <h2>O Cobdesk Nasce</h2>
            <p>O Cobhub é adaptado e evolui para se tornar o <span class="highlight">Cobdesk</span></p>
            <p style="margin-top: 40px; 1.4rem; color: #FFFFFF;">A plataforma central que integra todas as ferramentas Cobby</p>
        </div>
    </div>

    <!-- Slide 19: Continua -->
    <div class="slide" data-slide="18">
        <div class="slide-content">
            <div class="icon">🚀</div>
            <h2>A Jornada Continua</h2>
            <p>Agora é hora de conhecer o ecossistema completo</p>
            <p style="margin-top: 60px; 1.2rem; color: #98989D;">Parte 3: O Ecossistema Cobdesk</p>
            <a href="https://script.google.com/a/macros/aalima.com.br/s/AKfycbzS2Tofm-NQhO5BAspDlmHgXewmAkPvAzEB2uNEm1iD0BKrYzR9YfdmZirtGIznV4LVpw/exec" target="_blank" class="cta-button">Experimentar o Cobdesk</a>
        </div>
    </div>

    <!-- Navigation -->
    <div class="slide-indicator"></div>
    <div class="nav-hint">Clique ou use as setas para navegar</div>

    
    <!-- Slide Final: Escolha a Próxima Parte -->
    <div class="slide" data-slide="19">
        <div class="slide-content">
            <h2 style="margin-bottom: 40px;">Qual parte você quer ver agora?</h2>
            <div class="grid-3" style="max-width: 1000px; margin: 0 auto;">
                <a href="parte1-historia.html" class="card" style="text-decoration: none; cursor: pointer; transition: transform 0.3s ease;">
                    <div class="card-icon">📖</div>
                    <h4>Parte 1</h4>
                    <p>A Jornada de André Calabró</p>
                </a>
                <a href="parte2-solucao.html" class="card" style="text-decoration: none; cursor: pointer; transition: transform 0.3s ease;">
                    <div class="card-icon">🔍</div>
                    <h4>Parte 2</h4>
                    <p>A Busca pela Solução</p>
                </a>
                <a href="parte3-ecossistema.html" class="card" style="text-decoration: none; cursor: pointer; transition: transform 0.3s ease;">
                    <div class="card-icon">🎯</div>
                    <h4>Parte 3</h4>
                    <p>O Ecossistema Cobdesk</p>
                </a>
            </div>
            <a href="index.html" style="display: inline-block; margin-top: 60px; color: #98989D; text-decoration: none; 0.8rem;">← Voltar ao Início</a>
        </div>
    </div>

<script>
        let currentSlide = 0;
        const slides = document.querySelectorAll('.slide');
        const totalSlides = slides.length;
        const indicator = document.querySelector('.slide-indicator');

        // Create dots
        for (let i = 0; i < totalSlides; i++) {
            const dot = document.createElement('div');
            dot.className = 'dot';
            if (i === 0) dot.classList.add('active');
            indicator.appendChild(dot);
        }

        const dots = document.querySelectorAll('.dot');

        function goToSlide(n) {
            slides[currentSlide].classList.remove('active');
            dots[currentSlide].classList.remove('active');
            
            currentSlide = (n + totalSlides) % totalSlides;
            
            slides[currentSlide].classList.add('active');
            dots[currentSlide].classList.add('active');
        }

        function nextSlide() {
            goToSlide(currentSlide + 1);
        }

        function prevSlide() {
            goToSlide(currentSlide - 1);
        }

        // Click to advance
        document.addEventListener('click', (e) => {
            if (!e.target.closest('a') && !e.target.closest('.dot')) {
                nextSlide();
            }
        });

        // Keyboard navigation
        document.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowRight' || e.key === ' ') {
                e.preventDefault();
                nextSlide();
            } else if (e.key === 'ArrowLeft') {
                e.preventDefault();
                prevSlide();
            }
        });

        // Dot navigation
        dots.forEach((dot, index) => {
            dot.addEventListener('click', (e) => {
                e.stopPropagation();
                goToSlide(index);
            });
        });
    </script>
</body>
</html>
